{
  "name": "typescript-web-scan-target",
  "version": "1.0.0",
  "private": true,
  "description": "Small TypeScript HTTP API and browser page for safe local scanning",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "tsc -p tsconfig.json",
